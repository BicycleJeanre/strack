{
  "name": "strack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An offline-first Sudoku PWA with explanatory hints and transparent SE ratings.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-strack \"node --test tests/rules.test.mjs\"",
    "test:cloud": "firebase emulators:exec --only auth,firestore --project demo-strack \"playwright test --config playwright.cloud.config.ts\"",
    "test:base-path": "BASE_PATH=/strack/ npm run build && node scripts/check-base-path.mjs",
    "catalogue:build": "node scripts/build-catalogue.mjs",
    "catalogue:check": "node scripts/check-catalogue.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.0",
    "fake-indexeddb": "^6.2.4",
    "firebase-tools": "^15.30.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
